{
  "id": "./",
  "name": "Gym Manager",
  "short_name": "Gym",
  "description": "Plan your week, log sets and track your progress.",
  "start_url": "./#/today",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f4f1",
